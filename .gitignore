# Build output
public/

# OS
.DS_Store

# Quartz
.quartz/node_modules/
# Note the doubled path: the cache lives at .quartz/quartz/.quartz-cache,
# so a pattern of .quartz/.quartz-cache/ does not match it.
.quartz/quartz/.quartz-cache/

# Course readings (content/pdf) are ignored via .git/info/exclude, not here.
# Quartz globs content with gitignore: true, so a rule in this file would hide
# the PDFs from the local preview too. Keeping the rule out of tree means they
# build locally and still never reach the repo, so [pdf] links 404 only on the
# published site.

# Local Obsidian app state. Contains plugin credentials and large binaries;
# the site build does not need it. Matches the other course vaults, which
# never tracked it: this one had 1.9M of themes and snippets in the repo,
# which are editor appearance, not site content.
.obsidian/

# Local tooling caches
.smart-env/
.chum-cache/
.claude/

# Editor state. Local settings and appearance, not site content; the same
# reasoning that keeps .obsidian/ out.
.cursor/
.vscode/

# Canvas push artifacts. Regenerated by script/canvas on every run, the same
# way public/ is by the build; canvas.json (the course config) is tracked.
canvas-*.html
